# ~/.openclaw-manager/.env  (mode 0600; loaded by the generated ~/.openclaw-manager/bin/run-gateway)
#
# The secret names of the `default` profile (profiles/default.json lists them and where each comes from).
# `drover manager setup` writes this file once, one line per name copied from its source file or freshly
# generated, never a whole env file, and never prints a value. Do NOT add other provider keys
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...): they would let OpenClaw activate the openai/anthropic providers
# and reach api.openai.com / api.anthropic.com. `drover manager setup` refuses an .env with names the
# profile does not use, and `drover manager check` flags them. A profile in your overlay can take each
# name from another file ("from"); this lists the default profile's sources.
#
# The commercial Bedrock bearer: the AWS_BEARER_TOKEN_BEDROCK line of ~/.env_secrets.
AWS_BEARER_TOKEN_BEDROCK=EXAMPLE_copy_from_env_secrets

# The key the loopback CLIProxyAPI (127.0.0.1:8317) accepts: one of the api-keys in
# ~/.cli-proxy-api/config.yaml, as the CLIPROXY_API_KEY line of ~/.env_secrets. The config template
# reads it as ${CLIPROXY_API_KEY} (the profile's CLIPROXY_API_KEY template value), so it never sits in openclaw.json.
CLIPROXY_API_KEY=EXAMPLE_copy_from_env_secrets

# exa.ai search key: the EXA_API_KEY line of ~/.env_secrets. Egress: api.exa.ai only.
EXA_API_KEY=EXAMPLE_copy_from_env_secrets

# Gateway bearer for the loopback HTTP/WS surface (Drover adapter, manager-say,
# Control UI). Generated by setup (40 url-safe characters).
OPENCLAW_GATEWAY_TOKEN=EXAMPLE_gateway_token

# Separate token for POST /hooks/agent and /hooks/wake (never reuse the gateway token). Generated by setup.
OPENCLAW_HOOKS_TOKEN=EXAMPLE_hooks_token

# One optional name: OTEL_EXPORTER_OTLP_HEADERS, the Langfuse trace export auth (openclaw.json
# diagnostics.otel, endpoint the profile's OTEL_ENDPOINT). Setup derives it from LANGFUSE_PUBLIC_KEY and
# LANGFUSE_SECRET_KEY in ~/.env_secrets as Authorization=Basic%20<base64 of public:secret>, and adds it to an
# existing .env once those keys are there.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20EXAMPLE_base64_public_colon_secret
# No spend cap: cost stays visible in `openclaw gateway usage-cost` and the Drover Manager panel.
